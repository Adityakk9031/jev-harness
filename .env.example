# Copy to .env and fill in. Never commit .env.
# jev-harness reads these from the environment; it never writes them anywhere.

# --- Judge backends (all optional; `--judge none` needs none of them) --------
# TypeSafe Jev. Either name works; JEV_API_KEY wins if both are set.
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub (reviewer_eval) -------------------------------------------------
# If unset, jev-harness falls back to `gh auth token`.
GITHUB_TOKEN=

# --- Defaults (also settable in jev-harness.yml or via CLI flags) -----------
# JEV_JUDGE=none            # none | jev | anthropic | openai
# JEV_MIN_JUDGE_CONFIDENCE=0.7
# JEV_MIN_SAMPLES=30
# JEV_MIN_EVENTS=5
# JEV_MAX_COST_USD=
# JEV_MAX_RUNS=
# JEV_FAIL_ON=flag          # flag | escalate
# JEV_OUTPUT_DIR=.jev-harness
